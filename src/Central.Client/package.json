{
  "name": "central.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "start:win32": "ng serve --port %PORT%",
    "start:default": "ng serve --port $PORT",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:prod": "ng build --prod",
    "lint": "ng lint --fix && npm run lint:scss",
    "lint:ts": "eslint \"src/**/*.ts\" --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --fix"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.3.0",
  "dependencies": {
    "@angular/cdk": "^21.0.2",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.1.6",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.2",
    "@angular/material-date-fns-adapter": "^21.0.2",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@ng-matero/extensions": "^21.0.0",
    "@ng-matero/extensions-date-fns-adapter": "^21.0.0",
    "@ngneat/overview": "^7.0.0",
    "@ngx-formly/core": "^7.0.0",
    "@ngx-formly/material": "^7.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@ngxpert/hot-toast": "^6.0.0",
    "@ngxs/devtools-plugin": "^20.1.0",
    "@ngxs/logger-plugin": "^20.1.0",
    "@ngxs/store": "^20.1.0",
    "date-fns": "^4.1.0",
    "marked": "^17.0.1",
    "ng-matero": "^20.2.0",
    "ng2-pdf-viewer": "^10.4.0",
    "ngx-markdown": "^21.0.1",
    "ngx-permissions": "^19.0.0",
    "ngx-progressbar": "^14.0.0",
    "photoviewer": "^3.10.3",
    "prismjs": "^1.30.0",
    "run-script-os": "^1.1.6",
    "rxjs": "~7.8.0",
    "screenfull": "^6.0.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.0.0",
    "angular-eslint": "^21.0.1",
    "eslint": "^9.36.0",
    "jsdom": "^27.1.0",
    "parse5": "^8.0.0",
    "prettier": "^3.6.0",
    "stylelint": "^16.24.0",
    "stylelint-config-recess-order": "^7.3.0",
    "stylelint-config-recommended-scss": "^16.0.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^4.0.8"
  }
}
