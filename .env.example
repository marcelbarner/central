# PostgreSQL Configuration
POSTGRES_DB=central
POSTGRES_USER=central
POSTGRES_PASSWORD=central_password_change_me

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Connection String (will be automatically constructed from above)
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=central;Username=central;Password=central_password_change_me

# File System
FileSystem__Media=/app/media

# Port Mappings (host:container)
APP_PORT=8080
POSTGRES_PORT=5432
